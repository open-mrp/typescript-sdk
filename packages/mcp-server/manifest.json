{
  "dxt_version": "0.2",
  "name": "@openmrp/sdk-mcp",
  "version": "0.24.3",
  "description": "The official MCP Server for the Openmrp API",
  "author": {
    "name": "Openmrp",
    "email": "support@openmrp.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-mrp/typescript-sdk.git"
  },
  "homepage": "https://github.com/open-mrp/typescript-sdk/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ],
      "env": {
        "OPENMRP_API_KEY": "${user_config.OPENMRP_API_KEY}",
        "OPENMRP_OPENMRP_ACCOUNT_ID": "${user_config.OPENMRP_OPENMRP_ACCOUNT_ID}"
      }
    }
  },
  "user_config": {
    "OPENMRP_API_KEY": {
      "title": "bearer_token",
      "description": "API key sent as a Bearer token. Omit for cookie-based user sessions (dashboard).",
      "required": false,
      "type": "string"
    },
    "OPENMRP_OPENMRP_ACCOUNT_ID": {
      "title": "openmrp_account_id",
      "description": "Current account UUID (OpenMRP-Account). Update when switching accounts.",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "api"
  ]
}
